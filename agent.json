                        "type": "string"
                      },
                      "place_id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "district": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string"
                      },
                      "notes": {
                        "type": "string"
                      },
                      "cost_hkd": {
                        "type": "number"
                      },
                      "meal_slot": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string",
                            "enum": [
                              "breakfast",
                              "lunch",
                              "snack",
                              "dinner"
                            ]
                          }
                        ]
                      },
                      "transit_hkd": {
                        "type": "number",
                        "minimum": 0
                      },
                      "transit_before": {
                        "description": "Null for the first stop. Fare is also exposed as transit_hkd and counted once.",
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "time_start": {
                                "type": "string"
                              },
                              "time_end": {
                                "type": "string"
                              },
                              "from_place_id": {
                                "type": "string"
                              },
                              "to_place_id": {
                                "type": "string"
                              },
                              "mode": {
                                "type": "string"
                              },
                              "minutes": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "distance_km": {
                                "type": "number",
                                "minimum": 0
                              },
                              "cost_hkd": {
                                "type": "number",
                                "minimum": 0
                              },
                              "declared_transfer": {
                                "type": "boolean"
                              },
                              "notes": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "time_start",
                              "time_end",
                              "from_place_id",
                              "to_place_id",
                              "mode",
                              "minutes",
                              "distance_km",
                              "cost_hkd",
                              "declared_transfer"
                            ]
                          }
                        ]
                      }
                    },
                    "required": [
                      "time_start",
                      "time_end",
                      "place_id",
                      "name",
                      "district",
                      "category",
                      "cost_hkd",
                      "notes",
                      "transit_hkd",
                      "transit_before",
                      "meal_slot"
                    ]
                  }
                },
                "anchor": {
                  "description": "Geographic day anchor; null if the catalogue has no candidates.",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "district": {
                          "type": "string"
                        },
                        "region": {
                          "type": "string"
                        },
                        "lat": {
                          "type": "number"
                        },
                        "lng": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "district",
                        "region",
                        "lat",
                        "lng"
                      ]
                    }
                  ]
                },
                "planning_notes": {
                  "type": "string"
                },
                "budget_notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "day",
                "items"
              ]
            }
          },
          "cost": {
            "type": "object",
            "properties": {
              "total_hkd": {
                "type": "number"
              },
              "total_usd": {
                "type": "number"
              },
              "budget_usd": {
                "type": "number"
              },
              "within_budget": {
                "type": "boolean"
              },
              "breakdown": {
                "type": "object"
              }
            },
            "required": [
              "total_hkd",
              "total_usd",
              "budget_usd",
              "within_budget",
              "breakdown"
            ]
          },
          "summary": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "name",
